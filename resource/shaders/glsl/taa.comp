#version 450
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D currentColor; // Low Res (Jittered)
layout (binding = 1) uniform sampler2D historyColor; // High Res (Stable)
layout (binding = 2) uniform sampler2D depthTexture; // Low Res (Jittered)

layout (binding = 3, rgba16f) uniform image2D resultImage; // High Res (Target)

layout (push_constant) uniform PushConstants {
    mat4 inverseViewProj; // 当前帧抖动逆视图投影矩阵
    mat4 prevViewProj;    // 前一帧非抖动视图投影矩阵
    vec4 resolutionInfo;  // xy: 渲染分辨率 (低), zw: 显示分辨率 (高)
    float feedbackFactor; // 历史混合因子 (0.90 - 0.97)
    float padding1;
    float padding2;
    float padding3;
} pc;

vec3 RGBToYCoCg(vec3 rgb) {
    float Y = dot(rgb, vec3(0.25, 0.5, 0.25));
    float Co = dot(rgb, vec3(0.5, 0.0, -0.5));
    float Cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
    return vec3(Y, Co, Cg);
}

vec3 YCoCgToRGB(vec3 YCoCg) {
    float Y = YCoCg.x;
    float Co = YCoCg.y;
    float Cg = YCoCg.z;
    float r = Y + Co - Cg;
    float g = Y + Cg;
    float b = Y - Co - Cg;
    return vec3(r, g, b);
}

void main() {
    ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);
    vec2 displayRes = pc.resolutionInfo.zw;
    
    if (texelPos.x >= int(displayRes.x) || texelPos.y >= int(displayRes.y)) {
        return;
    }
    
    vec2 uv = (vec2(texelPos) + 0.5) / displayRes;
    
    // 1. Sample Current Color
    vec3 color = texture(currentColor, uv).rgb;
    
    // 2. Reconstruct Velocity
    float depth = texture(depthTexture, uv).r;
    
    // Unproject to World Space (using Current Jittered Inverse)
    vec4 clipPos;
    clipPos.x = uv.x * 2.0 - 1.0;
    clipPos.y = uv.y * 2.0 - 1.0;
    clipPos.z = depth;
    clipPos.w = 1.0;
    
    vec4 worldPos = pc.inverseViewProj * clipPos;
    worldPos /= worldPos.w;
    
    // Reproject to Previous Clip Space (using Previous Unjittered VP)
    vec4 prevClipPos = pc.prevViewProj * worldPos;
    prevClipPos /= prevClipPos.w;
    
    vec2 prevUV = prevClipPos.xy * 0.5 + 0.5;
    
    // 3. Sample History with Boundary Check
    vec3 history = vec3(0.0);
    bool validHistory = true;
    
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        validHistory = false;
    } else {
        history = texture(historyColor, prevUV).rgb;
    }
    
    if (!validHistory) {
        imageStore(resultImage, texelPos, vec4(color, 1.0));
        return;
    }
    
    // 4. Neighborhood Clamping (in YCoCg space for better quality)
    vec3 colorYCoCg = RGBToYCoCg(color);
    vec3 historyYCoCg = RGBToYCoCg(history);
    
    vec3 minColor = vec3(10000.0);
    vec3 maxColor = vec3(-10000.0);
    
    vec2 texelSize = 1.0 / pc.resolutionInfo.xy; // Low Res Texel Size
    
    // 3x3 Neighborhood
    for(int x=-1; x<=1; x++) {
        for(int y=-1; y<=1; y++) {
            vec3 neighbor = texture(currentColor, uv + vec2(x, y) * texelSize).rgb;
            vec3 neighborYCoCg = RGBToYCoCg(neighbor);
            minColor = min(minColor, neighborYCoCg);
            maxColor = max(maxColor, neighborYCoCg);
        }
    }
    
    // Shrink chroma range slightly? (Optional)
    
    // Clamp History
    historyYCoCg = clamp(historyYCoCg, minColor, maxColor);
    
    // 5. Blend
    float factor = pc.feedbackFactor; 
    
    vec3 resultYCoCg = mix(colorYCoCg, historyYCoCg, factor);
    vec3 result = YCoCgToRGB(resultYCoCg);
    
    imageStore(resultImage, texelPos, vec4(result, 1.0));
}
