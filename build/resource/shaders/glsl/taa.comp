#version 450
layout (local_size_x = 16, local_size_y = 16) in;

layout (binding = 0) uniform sampler2D currentColor; // Low Res (Jittered)
layout (binding = 1) uniform sampler2D historyColor; // High Res (Stable)
layout (binding = 2) uniform sampler2D depthTexture; // Low Res (Jittered)
layout (binding = 3, rgba16f) uniform image2D resultImage; // High Res (Target)
layout (binding = 4) uniform sampler2D gbuffer2; // Specular + Occlusion
layout (binding = 5) uniform sampler2D gbuffer3; // Normal + Smoothness

layout (push_constant) uniform PushConstants {
    mat4 inverseViewProj; // 当前帧抖动逆视图投影矩阵
    mat4 prevViewProj;    // 前一帧非抖动视图投影矩阵
    mat4 viewProj;        // 当前帧抖动视图投影矩阵 (用于SSR投影)
    vec4 resolutionInfo;  // xy: 渲染分辨率 (低), zw: 显示分辨率 (高)
    vec4 cameraPos;       // 相机世界空间位置 (xyz)
    float feedbackFactor; // 历史混合因子 (0.90 - 0.97)
    uint enableSSR;
    uint ssrMaxSteps;
    float ssrStepSize;
    float ssrThickness;
    float ssrStrength;
    uint frameCount;
    uint enableSSRSpatial;
} pc;

vec3 RGBToYCoCg(vec3 rgb) {
    float Y = dot(rgb, vec3(0.25, 0.5, 0.25));
    float Co = dot(rgb, vec3(0.5, 0.0, -0.5));
    float Cg = dot(rgb, vec3(-0.25, 0.5, -0.25));
    return vec3(Y, Co, Cg);
}

vec3 YCoCgToRGB(vec3 YCoCg) {
    float Y = YCoCg.x;
    float Co = YCoCg.y;
    float Cg = YCoCg.z;
    float r = Y + Co - Cg;
    float g = Y + Cg;
    float b = Y - Co - Cg;
    return vec3(r, g, b);
}

vec3 reconstructWorldPosition(vec2 uv, float depth) {
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = pc.inverseViewProj * clipPos;
    return worldPos.xyz / worldPos.w;
}

// 经典的哈希随机数发生器
vec2 hash22(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * vec3(.1031, .11369, .13787));
    p3 += dot(p3, p3.yzx + 19.19);
    return fract(vec2((p3.x + p3.y)*p3.z, (p3.x+p3.z)*p3.y));
}

// GGX 重要性采样
vec3 importanceSampleGGX(vec2 xi, float roughness, vec3 N) {
    float a = roughness * roughness;
    
    float phi = 2.0 * 3.14159265359 * xi.x;
    float cosTheta = sqrt(max(0.0, (1.0 - xi.y) / (1.0 + (a*a - 1.0) * xi.y)));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    
    // 从球面坐标转换到切线空间 (H_local)
    vec3 H;
    H.x = cos(phi) * sinTheta;
    H.y = sin(phi) * sinTheta;
    H.z = cosTheta;
    
    // 构建从切线空间到世界空间的 TBN 变换矩阵
    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    
    // 转换到世界空间并返回微面元法线 H
    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

vec3 calculateSSR(vec2 uv, vec3 worldPos, vec3 normalWorld, float smoothness, vec3 specular) {
    float roughness = clamp(1.0 - smoothness, 0.0, 1.0);
    
    // 根据 UV 与帧数生成每帧唯一的 2D 随机偏移 xi
    vec2 xi = hash22(uv * 1000.0 + vec2(float(pc.frameCount) * 1.61803));
    
    // 依照材质粗糙度重要性采样产生微观法线 H
    vec3 H = importanceSampleGGX(xi, roughness, normalWorld);
    
    vec3 viewDir = normalize(worldPos - pc.cameraPos.xyz);
    
    // 产生带散射抖动的随机反射光线
    vec3 reflectDir = reflect(viewDir, H);

    // 避免反射进几何面内部
    if (dot(reflectDir, normalWorld) < 0.0) {
        reflectDir = reflect(viewDir, normalWorld); // Fallback 到镜面反射
    }

    int maxSteps = int(pc.ssrMaxSteps);
    float stepSize = pc.ssrStepSize;
    float thickness = pc.ssrThickness;

    // 引入 step Jitter 步长抖动，打散固定步进采样点的条带状层纹 (Banding)
    float stepJitter = hash22(uv * 700.0 + vec2(float(pc.frameCount) * 3.14159)).x;
    vec3 currentRayPos = worldPos + reflectDir * stepSize * stepJitter;
    vec2 hitUV = vec2(0.0);
    bool hit = false;

    for (int i = 0; i < maxSteps; i++) {
        currentRayPos += reflectDir * stepSize;

        // 投影到屏幕空间
        vec4 projectedPos = pc.viewProj * vec4(currentRayPos, 1.0);
        projectedPos.xyz /= projectedPos.w;
        vec2 sampleUV = projectedPos.xy * 0.5 + 0.5;

        // 边界检查
        if (sampleUV.x < 0.0 || sampleUV.x > 1.0 || sampleUV.y < 0.0 || sampleUV.y > 1.0) {
            break;
        }

        // 采样深度并重建世界位置
        float sampledDepth = texture(depthTexture, sampleUV).r;
        if (sampledDepth >= 0.9999) continue;

        vec3 sampledWorldPos = reconstructWorldPosition(sampleUV, sampledDepth);

        float rayDist = length(currentRayPos - pc.cameraPos.xyz);
        float sampleDist = length(sampledWorldPos - pc.cameraPos.xyz);

        if (rayDist >= sampleDist && (rayDist - sampleDist) < thickness) {
            // 发生碰撞，使用二分查找精细调整
            vec3 minRayPos = currentRayPos - reflectDir * stepSize;
            vec3 maxRayPos = currentRayPos;
            
            for (int j = 0; j < 5; j++) {
                vec3 midRayPos = mix(minRayPos, maxRayPos, 0.5);
                vec4 midProj = pc.viewProj * vec4(midRayPos, 1.0);
                midProj.xyz /= midProj.w;
                vec2 midUV = midProj.xy * 0.5 + 0.5;
                
                float d = texture(depthTexture, midUV).r;
                vec3 p = reconstructWorldPosition(midUV, d);
                
                float rDist = length(midRayPos - pc.cameraPos.xyz);
                float sDist = length(p - pc.cameraPos.xyz);
                
                if (rDist >= sDist && (rDist - sDist) < thickness) {
                    maxRayPos = midRayPos;
                    hitUV = midUV;
                } else {
                    minRayPos = midRayPos;
                }
            }
            hit = true;
            break;
        }
    }

    if (hit) {
        // 边缘渐变淡出
        vec2 edge = vec2(1.0) - abs(hitUV * 2.0 - 1.0);
        float edgeFade = clamp(edge.x * edge.y * 10.0, 0.0, 1.0);

        // 采样当前帧未过滤颜色作为反射源
        vec3 reflectedColor = texture(currentColor, hitUV).rgb;

        // 菲涅尔效应
        float cosTheta = max(dot(normalWorld, -viewDir), 0.0);
        vec3 F = specular + (vec3(1.0) - specular) * pow(1.0 - cosTheta, 5.0);

        return reflectedColor * F * smoothness * pc.ssrStrength * edgeFade;
    }

    return vec3(0.0);
}

shared vec3 sharedSsr[16][16];
shared float sharedDist[16][16];
shared vec3 sharedNormal[16][16];
shared vec3 sharedFinalColor[16][16];

void main() {
    ivec2 texelPos = ivec2(gl_GlobalInvocationID.xy);
    vec2 displayRes = pc.resolutionInfo.zw;
    uvec2 localID = gl_LocalInvocationID.xy;
    
    vec2 uv = (vec2(texelPos) + 0.5) / displayRes;
    
    // 边界检查
    bool inBounds = (texelPos.x < int(displayRes.x) && texelPos.y < int(displayRes.y));
    
    // 1. Sample Current Color
    vec3 color = vec3(0.0);
    float depth = 1.0;
    if (inBounds) {
        color = texture(currentColor, uv).rgb;
        depth = texture(depthTexture, uv).r;
    }
    
    // 2. Reconstruct Position & Calculate SSR
    vec3 worldPos = vec3(0.0);
    vec3 ssrColor = vec3(0.0);
    vec3 normalWorld = vec3(0.0);
    
    if (inBounds && pc.enableSSR != 0u && depth < 0.9999) {
        worldPos = reconstructWorldPosition(uv, depth);
        normalWorld = texture(gbuffer3, uv).rgb * 2.0 - 1.0;
        normalWorld = normalize(normalWorld);
        
        float smoothness = texture(gbuffer3, uv).a;
        vec3 specular = texture(gbuffer2, uv).rgb;
        
        ssrColor = calculateSSR(uv, worldPos, normalWorld, smoothness, specular);
    }
    
    float camDist = length(worldPos - pc.cameraPos.xyz);
    
    // 写入共享内存以供空域复用
    sharedSsr[localID.x][localID.y] = ssrColor;
    sharedDist[localID.x][localID.y] = camDist;
    sharedNormal[localID.x][localID.y] = normalWorld;
    
    barrier();
    
    // 应用空域双边滤波进行去噪复用
    vec3 finalSsr = ssrColor;
    if (inBounds && pc.enableSSR != 0u && pc.enableSSRSpatial != 0u && depth < 0.9999) {
        vec3 filteredSsr = vec3(0.0);
        float totalWeight = 0.0;
        
        for (int x = -1; x <= 1; x++) {
            for (int y = -1; y <= 1; y++) {
                int nx = int(localID.x) + x;
                int ny = int(localID.y) + y;
                
                ivec2 neighborGlobalPos = ivec2(gl_GlobalInvocationID.xy) + ivec2(x, y);
                bool neighborInBounds = (neighborGlobalPos.x >= 0 && neighborGlobalPos.x < int(displayRes.x) &&
                                         neighborGlobalPos.y >= 0 && neighborGlobalPos.y < int(displayRes.y));
                
                nx = clamp(nx, 0, 15);
                ny = clamp(ny, 0, 15);
                
                if (neighborInBounds) {
                    vec3 neighborSsr = sharedSsr[nx][ny];
                    float neighborDist = sharedDist[nx][ny];
                    vec3 neighborNormal = sharedNormal[nx][ny];
                    
                    // 双边权重：深度/距离差异权重 (0.5米差异衰减为原来的exp(-1))，法线差异权重 (8次方)
                    float distWeight = exp(-abs(neighborDist - camDist) * 2.0);
                    float normalWeight = pow(max(0.0, dot(neighborNormal, normalWorld)), 8.0);
                    float weight = distWeight * normalWeight;
                    
                    filteredSsr += neighborSsr * weight;
                    totalWeight += weight;
                }
            }
        }
        
        if (totalWeight > 0.0) {
            finalSsr = filteredSsr / totalWeight;
        }
    }
    
    // 将最终计算出的合成颜色写入共享内存以供 TAA Neighborhood Clamping 复用
    vec3 finalColor = color + finalSsr;
    sharedFinalColor[localID.x][localID.y] = finalColor;
    
    barrier();
    
    // 越界线程退出
    if (!inBounds) {
        return;
    }
    
    // 3. Reproject to Previous Clip Space (using Previous Unjittered VP)
    vec4 prevClipPos = pc.prevViewProj * vec4(worldPos, 1.0);
    prevClipPos /= prevClipPos.w;
    
    vec2 prevUV = prevClipPos.xy * 0.5 + 0.5;
    
    // 4. Sample History with Boundary Check
    vec3 history = vec3(0.0);
    bool validHistory = true;
    
    if (prevUV.x < 0.0 || prevUV.x > 1.0 || prevUV.y < 0.0 || prevUV.y > 1.0) {
        validHistory = false;
    } else {
        history = texture(historyColor, prevUV).rgb;
    }
    
    if (!validHistory) {
        imageStore(resultImage, texelPos, vec4(finalColor, 1.0));
        return;
    }
    
    // 5. Neighborhood Clamping (in YCoCg space for better quality)
    vec3 colorYCoCg = RGBToYCoCg(finalColor);
    vec3 historyYCoCg = RGBToYCoCg(history);
    
    vec3 minColor = vec3(10000.0);
    vec3 maxColor = vec3(-10000.0);
    
    vec2 texelSize = 1.0 / pc.resolutionInfo.xy; // Low Res Texel Size
    
    // 3x3 邻域夹击：直接从共享内存获取最终颜色，对于边界像素降级采样纹理，完全免除冗余 SSR 跟踪
    for(int x=-1; x<=1; x++) {
        for(int y=-1; y<=1; y++) {
            int nx = int(localID.x) + x;
            int ny = int(localID.y) + y;
            
            vec3 neighbor;
            if (nx >= 0 && nx < 16 && ny >= 0 && ny < 16) {
                neighbor = sharedFinalColor[nx][ny];
            } else {
                // 越过工作组边界的像素退化处理，避免大开销的 trace
                vec2 offsetUV = uv + vec2(x, y) * texelSize;
                neighbor = texture(currentColor, offsetUV).rgb + finalSsr;
            }
            
            vec3 neighborYCoCg = RGBToYCoCg(neighbor);
            minColor = min(minColor, neighborYCoCg);
            maxColor = max(maxColor, neighborYCoCg);
        }
    }
    
    // Clamp History
    historyYCoCg = clamp(historyYCoCg, minColor, maxColor);
    
    // 6. Blend
    float factor = pc.feedbackFactor; 
    
    vec3 resultYCoCg = mix(colorYCoCg, historyYCoCg, factor);
    vec3 result = YCoCgToRGB(resultYCoCg);
    
    imageStore(resultImage, texelPos, vec4(result, 1.0));
}
